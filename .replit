version = "2.0.0"
modules = ["nodejs-24"]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[[artifacts]]
id = "artifacts/api-server"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
